+@keyframes dots { 0% { content: ""; } 25% { content: "."; } 50% { content: ".."; } 75%,100% { content: "..."; } }
+
+.site-footer { background: var(--forest-950); color: rgba(255,255,255,.68); padding: 30px 20px; text-align: center; }
+
+@media (min-width: 680px) {
+  .filter-panel { grid-template-columns: 1.4fr repeat(3, 1fr); }
+  .guide-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .form-grid.two-columns { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .gallery-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+}
+
+@media (min-width: 980px) {
+  .guide-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+  .hero-inner { padding-top: 84px; }
+  .profile-layout { grid-template-columns: minmax(0, 1fr) 320px; }
+  .profile-contact { position: sticky; top: 20px; }
+}
+
+@media (max-width: 540px) {
+  .nav-actions .nav-link:first-child { display: none; }
+  .site-nav { padding-inline: 16px; }
+  .hero-inner,
+  .page-shell { padding-left: 16px; padding-right: 16px; }
+  .button { width: 100%; }
+  .guide-card .button { width: auto; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; }
+}
+
